<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Maoxig.RuntimeVmd</AssemblyName>
    <RootNamespace>Maoxig.RuntimeVmd</RootNamespace>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Version>0.2.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableDefaultCompileItems>False</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">F:\Program Files\7D2D\GameInstalls\7DTD-2.6</GameRoot>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GameRoot)\7DaysToDie_Data\Managed</GameManagedDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- MateEngine's shipped UnityEngine reference exposes Camera.orthographic
         as read-only. Runtime Unity package builds and 7DTD/net48 keep the
         normal setter path. -->
    <DefineConstants>$(DefineConstants);RUNTIMEVMD_CAMERA_ORTHOGRAPHIC_READONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Runtime\**\*.cs" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
